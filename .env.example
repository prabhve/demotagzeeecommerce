# TAG ZEE LUXURY B2C E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your production credentials when deploying.

PORT=5000
NODE_ENV=development

# 1. Razorpay Payment Gateway (India)
# Retrieve from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# 2. Shiprocket Courier Logistics Integration
# Retrieve from Shiprocket API settings
SHIPROCKET_API_EMAIL=operations@tagzee.in
SHIPROCKET_API_PASSWORD=YourShiprocketPasswordHere

# 3. WhatsApp Business Cloud API / Provider
# Retrieve from Meta Developers or Twilio/Gupshup
WHATSAPP_API_TOKEN=YourWhatsAppCloudApiTokenHere
WHATSAPP_PHONE_NUMBER_ID=YourWhatsAppPhoneNumberIdHere
TAGZEE_OFFICIAL_WHATSAPP=+917351366786

# 4. Transactional Email (Resend / SendGrid / Brevo)
EMAIL_PROVIDER_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM_ADDRESS=orders@tagzee.in

# 5. Admin Portal Security PIN / Secret
ADMIN_ACCESS_SECRET=tagzee@admin2026
JWT_SECRET=super_secret_jwt_key_for_tagzee_sessions_2026
